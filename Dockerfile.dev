# Development image for the `web` service. The compose file that runs it lives
# in ../be-push-notification-tool/docker-compose.yml, next to the API and MySQL.
# Not for staging/production: it runs `next dev` against the source
# bind-mounted from the host, so edits hot-reload the same way they do locally.
#
# Only the dependencies are baked in; the source never is.
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

EXPOSE 3000

# 0.0.0.0 so the port published by compose reaches the dev server.
CMD ["yarn", "dev", "-H", "0.0.0.0"]
